int Length(char arr[])
{
	int i = 0;

	while (arr[i] != '\0')
	{
		i++;
	}

	return i;
}

int main()
{
	char text[255];

	cout << "Enter text : ";
	cin.getline(text, 255);

	cout << "Length = " << Length(text) << endl;
}
