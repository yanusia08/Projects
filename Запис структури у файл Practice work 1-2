const char* filename = "BooksDatabase.txt";

struct Book
{
	int id;
	char title[50];
	char author[50];
	char publisher[50];
	char genre[50];
	int year_publication;
	float price;

	void SaveToFile()
	{
		ofstream out(filename, ios_base::app);
		out << id << ':';
		out << title << ':';
		out << author << ':';
		out << publisher << ':';
		out << genre << ':';
		out << year_publication << ':';
		out << price << '|';
		out.close();
	}

	void CopyFromFile(int idF, char* titleF, char* authorF, char* publisherF, char* genreF, int yearF, float priceF)
	{
		id = idF;
		strcpy(title, titleF);
		strcpy(author, authorF);
		strcpy(publisher, publisherF);
		strcpy(genre, genreF);
		year_publication = yearF;
		price = priceF;
	}
};

void Show(Book* books, int size)
{
	for (int i = 0; i < size; i++)
	{
		cout << "Book " << books[i].id << endl;
		cout << "Name: " << books[i].title << endl;
		cout << "Author: " << books[i].author << endl;
		cout << "Publisher: " << books[i].publisher << endl;
		cout << "Genre: " << books[i].genre << endl;
		cout << "Year: " << books[i].year_publication << endl;
		cout << "Price: " << books[i].price << endl;
	}
}

void ShowOneBook(Book book)
{
	cout << "Book " << book.id << endl;
	cout << "Name: " << book.title << endl;
	cout << "Author: " << book.author << endl;
	cout << "Publisher: " << book.publisher << endl;
	cout << "Genre: " << book.genre << endl;
	cout << "Year: " << book.year_publication << endl;
	cout << "Price: " << book.price << endl;
}

void SearchByAuthor(char author[], Book* books, int size)
{
	for (int i = 0; i < size; i++)
	{
		if (strcmp(books[i].author, author) == 0)
		{
			ShowOneBook(books[i]);
		}
	}
}

void SearchByTitlee(char title[], Book* books, int size)
{
	for (int i = 0; i < size; i++)
	{
		if (strcmp(books[i].title, title) == 0)
		{
			ShowOneBook(books[i]);
		}
	}
}

void SearchByPublisher(char publisher[], Book* books, int size)
{
	for (int i = 0; i < size; i++)
	{
		if (strcmp(books[i].publisher, publisher) == 0)
		{
			ShowOneBook(books[i]);
		}
	}
}

void SearchByGenre(char genre[], Book* books, int size)
{
	for (int i = 0; i < size; i++)
	{
		if (strcmp(books[i].genre, genre) == 0)
		{
			ShowOneBook(books[i]);
		}
	}
}

void ChangeData(Book* books, int size, int id)
{
	for (int i = 0; i < size; i++)
	{
		if (books[i].id == id)
		{
			ShowOneBook(books[i]);
			cout << "Enter new price : ";
			cin >> books[i].price;
		}
	}
}

