void Diagonal(int arr[][3], int size)
{
    int max = arr[0][0];
    int min = arr[0][0];

    for (int i = 0; i < size; i++)
    {
        if (arr[i][i] > max)
        {
            max = arr[i][i];
        }

        if (arr[i][i] < min)
        {
            min = arr[i][i];
        }
    }

    cout << "Max = " << max << endl;
    cout << "Min = " << min << endl;
}

void Diagonal(double arr[][3], int size)
{
    double max = arr[0][0];
    double min = arr[0][0];

    for (int i = 0; i < size; i++)
