int main()
{
    int a = 10, b = 20, c = 15;
    float x = 10.5, y = 20.5;

    cout << "Max = " << Max(a, b) << endl;
    cout << "Max = " << Max(x, y) << endl;
    cout << "Max = " << Max(a, b, c) << endl;

    cout << "Min = " << Min(a, b) << endl;
    cout << "Min = " << Min(a, b, c) << endl;

    cout << "-----------------------------------------" << endl;

    int arr1[5] = { 10, 20, 30, 40, 50 };

