void InitArray(int* arr, int size)
{
	for (int i = 0; i < size; i++)
	{
		*(arr + i) = rand() % 50;
	}
}

void ShowArray(int* arr, int size)
{
	for (int i = 0; i < size; i++)
	{
		cout << *(arr + i) << " ";
	}
	cout << endl;
}

void Change(int* arr, int size)
{
	int temp;

	for (int i = 0; i < size - 1; i += 2)
	{
		temp = *(arr + i);
		*(arr + i) = *(arr + i + 1);
		*(arr + i + 1) = temp;
	}
}

int main()
{
	const int size = 10;
	int arr[size];

	InitArray(arr, size);
	ShowArray(arr, size);

	Change(arr, size);

	ShowArray(arr, size);
}
