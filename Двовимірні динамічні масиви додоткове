int** DeleteColumnByPosition(int** arr, int rows, int& cols, int pos)
{
	int** temp = new int* [rows];

	for (int i = 0; i < rows; i++)
	{
		temp[i] = new int[cols - 1];

		for (int j = 0; j < pos; j++)
		{
			temp[i][j] = arr[i][j];
		}

		for (int j = pos; j < cols - 1; j++)
		{
			temp[i][j] = arr[i][j + 1];
		}
	}

	for (int i = 0; i < rows; i++)
	{
		delete[] arr[i];
	}

	delete[] arr;

	cols--;

	return temp;
}

int main()
{
	int rows = 4;
	int cols = 5;

	int** arr = new int* [rows];

	for (int i = 0; i < rows; i++)
	{
		arr[i] = new int[cols];
	}

	InitArray(arr, rows, cols);
	ShowArray(arr, rows, cols);

	arr = DeleteColumnByPosition(arr, rows, cols, 2);
	ShowArray(arr, rows, cols);

	for (int i = 0; i < rows; i++)
	{
		delete[] arr[i];
	}

	delete[] arr;
}
