void InitArray(int arr[], int size)
{
	for (int i = 0; i < size; i++)
	{
		arr[i] = i + 1;
	}
}

void ShowArray(int arr[], int size)
{
	for (int i = 0; i < size; i++)
	{
		cout << arr[i] << " ";
	}
	cout << endl;
}

void MixArray(int arr[], int size)
{
	int temp, index;

	for (int i = 0; i < size; i++)
	{
		index = rand() % size;

		temp = arr[i];
		arr[i] = arr[index];
		arr[index] = temp;
	}
}

int LinearSearch(int arr[], int size, int search)
{
	for (int i = 0; i < size; i++)
	{
		if (arr[i] == search)
		{
			return i;
		}
	}
	return -1;
}

void SortArray(int arr[], int size, int index)
{
	int temp;

	for (int i = 0; i < index; i++)
	{
		for (int j = index - 1; j > i; j--)
		{
			if (arr[j - 1] < arr[j])
			{
				temp = arr[j - 1];
				arr[j - 1] = arr[j];
				arr[j] = temp;
			}
		}
	}

	for (int i = index + 1; i < size; i++)
	{
		for (int j = size - 1; j > i; j--)
		{
			if (arr[j - 1] > arr[j])
			{
				temp = arr[j - 1];
				arr[j - 1] = arr[j];
				arr[j] = temp;
			}
		}
	}
}

int main()
{
	srand(time(0));

	const int size = 20;
	int arr[size];

	int search_num, index_find;

	InitArray(arr, size);
	MixArray(arr, size);
	ShowArray(arr, size);

	search_num = rand() % 20 + 1;

	cout << "Search number = " << search_num << endl;

	index_find = LinearSearch(arr, size, search_num);

	cout << "Index = " << index_find << endl;

	SortArray(arr, size, index_find);
	ShowArray(arr, size);
}
